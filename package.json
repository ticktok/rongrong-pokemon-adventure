{
  "name": "rongrong-pokemon-adventure",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-live.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-function.mjs",
    "assets": "python3 scripts/prepare-assets.py",
    "cloudbase": "tcb",
    "preview": "vite preview --host 127.0.0.1",
    "backup": "node scripts/backup-save.mjs",
    "deploy:web": "node scripts/deploy-web.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "backup:restore": "node scripts/restore-backup.mjs",
    "verify:saves": "node scripts/verify-save-compatibility.mjs"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "latest",
    "@cloudbase/node-sdk": "latest",
    "@fontsource/noto-sans-sc": "latest",
    "@fontsource/nunito": "latest",
    "@fontsource/zcool-kuaile": "latest",
    "lucide-react": "latest",
    "phaser": "3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudbase/cli": "3.8.7",
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "latest",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "5.0.5"
  }
}
